<!doctype html>
<html lang="he" dir="rtl"><head><meta charset="utf-8">
{% for f in fonts %}{% if f.google and not f.file %}<link href="https://fonts.googleapis.com/css2?family={{ f.family|replace(' ', '+') }}:wght@{{ f.weight }}&display=swap" rel="stylesheet">{% endif %}{% endfor %}
<style>
  {% for f in fonts %}{% if f.file %}@font-face{font-family:'{{ f.family }}';src:url('{{ f.file_uri }}');font-weight:{{ f.weight }};}{% endif %}{% endfor %}
  html,body{margin:0;padding:0}
  .ad{position:relative;width:{{w}}px;height:{{h}}px;overflow:hidden;background:#000}
  .ad img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  {% set x0,y0,x1,y1 = box %}
  {% set is_top = y0 < h/2 %}
  /* soft local shade only behind the text zone, never over the whole image */
  .shade{position:absolute;left:0;right:0;{% if is_top %}top:0;height:{{ y1 + 60 }}px;{% else %}bottom:0;height:{{ h - y0 + 60 }}px;{% endif %}
    background:linear-gradient({{ 'to bottom' if is_top else 'to top' }}, {{ 'rgba(0,0,0,.42)' if dark_bg else 'rgba(255,250,242,.50)' }}, transparent)}
  {% if st.band %}.shade{display:none}
  .band{position:absolute;left:0;right:0;bottom:0;height:{{ (h*0.2)|int }}px;background:{{ 'rgba(12,10,8,.82)' if dark_bg else 'rgba(250,246,238,.9)' }};backdrop-filter:blur(6px)}{% endif %}
  .copy{position:absolute;
    {% if st.band %}left:80px;right:80px;bottom:0;height:{{ (h*0.2)|int }}px;display:flex;flex-direction:column;justify-content:center;
    {% else %}left:{{x0}}px;top:{{y0}}px;width:{{x1-x0}}px;height:{{y1-y0}}px;display:flex;flex-direction:column;justify-content:{{ 'flex-start' if is_top else 'flex-end' }};{% endif %}
    text-align:{{ 'right' if st.align=='start' else 'center' }};color:{{color}}}
  .h{text-wrap:balance;font-family:'{{ hf.family }}',serif;font-weight:{{ hf.weight }};font-size:{{size}}px;line-height:{{ 0.98 if style=='bigtype' else 1.12 }};letter-spacing:{{ '-1px' if style=='bigtype' else '0' }}}
  .rule{width:64px;height:2px;background:{{color}};opacity:.7;margin:{{ '22px 0 0 auto' if st.align=='start' else '22px auto 0' }}}
  .sub{font-family:'{{ sf.family }}',sans-serif;font-weight:{{ sf.weight }};font-size:{{ st.sub }}px;letter-spacing:1.5px;margin-top:18px;opacity:.88}
  .frame{position:absolute;inset:36px;border:1.5px solid {{ 'rgba(244,236,223,.75)' if dark_bg else 'rgba(35,26,18,.55)' }};pointer-events:none}
  .brand{position:absolute;left:0;right:0;{{ 'bottom' if (is_top and not st.band) else 'top' }}:{{ 70 if st.frame else 60 }}px;text-align:center;
    color:{{ '#f4ecdf' if brand_dark or st.band else '#2a2018' }};text-shadow:{{ '0 1px 10px rgba(0,0,0,.5)' if brand_dark else 'none' }};font-family:'{{ bf.family }}',serif;font-weight:{{ bf.weight }};font-size:24px;letter-spacing:1px;opacity:.85}
</style></head>
<body><div class="ad">
  <img src="{{img}}">
  <div class="shade"></div>
  {% if st.band %}<div class="band"></div>{% endif %}
  {% if st.frame %}<div class="frame"></div>{% endif %}
  <div class="copy">
    <div class="h">{{headline|safe}}</div>
    {% if st.rule %}<div class="rule"></div>{% endif %}
    {% if sub %}<div class="sub">{{sub}}</div>{% endif %}
  </div>
  {% if brand %}<div class="brand">{{brand}}</div>{% endif %}
</div></body></html>
