<!doctype html>
<html lang="he" dir="rtl"><head><meta charset="utf-8">
<style>
  @font-face{font-family:'OptL';src:url('{{ fonts.light }}')}
  @font-face{font-family:'OptR';src:url('{{ fonts.regular }}')}
  @font-face{font-family:'OptB';src:url('{{ fonts.black }}')}
  @font-face{font-family:'Script';src:url('{{ fonts.script }}')}
  :root{--ink:{{ ink }};--paper:{{ paper }};--accent:{{ accent }}}
  html,body{margin:0;padding:0}
  *{box-sizing:border-box}
  .ad{position:relative;width:{{w}}px;height:{{h}}px;overflow:hidden;background:var(--paper);color:var(--ink)}
  .photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:{{ obj_pos }}}
  .L{font-family:'OptL'} .R{font-family:'OptR'} .B{font-family:'OptB'} .S{font-family:'Script'}
  /* Idealist is a hairline script: thicken the stroke so it survives a phone screen */
  .sig,.hand{-webkit-text-stroke:1.4px currentColor}
  .zone{position:absolute;left:{{box[0]}}px;top:{{box[1]}}px;width:{{box[2]-box[0]}}px;height:{{box[3]-box[1]}}px;
        display:flex;flex-direction:column;justify-content:{{ 'flex-start' if top else 'flex-end' }}}
  .fit{white-space:nowrap}
  {% if plate %}.zone{height:auto;width:auto;max-width:{{box[2]-box[0]}}px;left:auto;right:{{w-box[2]}}px;
    {% if top %}top:{{box[1]}}px{% else %}top:auto;bottom:{{h-box[3]}}px{% endif %};padding:30px 38px;
    background:{{ plate_bg or ('rgba(14,11,8,.66)' if ink=='#f4ecdf' else 'rgba(250,246,238,.84)') }};backdrop-filter:blur(12px)}
  .scrim{display:none}{% endif %}
  .zone{ {% if ink=='#f4ecdf' %}text-shadow:0 2px 18px rgba(0,0,0,.45){% endif %} }
  .brand{position:absolute;left:0;right:0;{{ 'bottom' if top else 'top' }}:54px;text-align:center;font-family:'OptR';font-size:34px;letter-spacing:2px;
         color:{{ brand_color }}}
  /* scrim: a band feathered on all sides around the text only (half-width text fades sideways too),
     at the strength legibility() measured — never a box, never a strip */
  .scrim{position:absolute;top:{{ box[1]-170 }}px;height:{{ box[3]-box[1]+340 }}px;left:0;right:0;
    background:{% if (box[2]-box[0]) < w*0.6 %}linear-gradient(to {{ 'left' if box[2] > w*0.6 else 'right' }}, {{ scrim }} 0, {{ scrim }} 50%, transparent 85%){% else %}{{ scrim }}{% endif %};
    -webkit-mask-image:linear-gradient(to bottom, transparent 0, #000 170px, #000 calc(100% - 170px), transparent 100%);
            mask-image:linear-gradient(to bottom, transparent 0, #000 170px, #000 calc(100% - 170px), transparent 100%)}
  .brand{text-shadow:0 1px 12px rgba(0,0,0,{{ '.5' if brand_color=='#f4ecdf' else '0' }})}

  /* 1 contrast — Black keyword line vs. Light line, aligned to the text start */
  .contrast .l1{font-family:'OptB';font-size:112px;line-height:.95;letter-spacing:-1px}
  .contrast .l2{font-family:'OptL';font-size:72px;line-height:1.1;margin-top:10px}
  .contrast .sub{font-family:'OptR';font-size:38px;letter-spacing:1px;margin-top:26px}
  .contrast .zone{text-align:right}

  /* 2 quiet — perfume-ad restraint: small Light text, wide air, handwritten signature */
  .quiet .zone{text-align:center;align-items:center}
  .quiet .hl{font-family:'OptR';font-size:84px;line-height:1.2}
  .quiet .sig{font-family:'Script';font-size:120px;margin-top:6px;line-height:1}
  .quiet .sub{font-family:'OptR';font-size:38px;letter-spacing:1px;margin-top:14px}

  /* 3 stack — oversized Black stacked headline, tight leading */
  .stack .zone{text-align:right}
  .stack .l{font-family:'OptB';font-size:170px;line-height:.9;letter-spacing:-2px}
  .stack .l.light{font-family:'OptL'}
  .stack .sub{font-family:'OptR';font-size:38px;letter-spacing:1px;margin-top:22px}

  /* 4 note — designer's handwritten note + small product line */
  .note .zone{text-align:right}
  .note .hand{font-family:'Script';font-size:124px;line-height:1.05}
  .note .rule{width:90px;height:1.5px;background:var(--ink);opacity:.6;margin:22px 0 16px auto}
  .note .sub{font-family:'OptR';font-size:38px;letter-spacing:1px}
  .note .hl{font-family:'OptB';font-size:62px;margin-top:6px}

  /* 5 cover — thin frame, magazine masthead feel */
  .cover .frame{position:absolute;inset:34px;border:1.5px solid var(--ink);opacity:.55}
  .cover .mast{position:absolute;left:0;right:0;{{ 'bottom' if top else 'top' }}:64px;text-align:center;font-family:'OptB';font-size:30px;letter-spacing:6px;color:var(--ink)}
  .cover .zone{text-align:center;align-items:center}
  .cover .hl{font-family:'OptR';font-size:78px;line-height:1.08}
  .cover .sub{font-family:'OptB';font-size:36px;letter-spacing:2px;margin-top:22px}
  .cover .brand{display:none}

  /* 6 panel — solid colour panel beside/below the photo: text never touches the product */
  .panel .photo{ {% if panel_side == 'bottom' %}height:{{ (h*0.68)|int }}px{% else %}width:{{ (w*0.6)|int }}px;left:{{ 0 if panel_side=='right' else (w*0.4)|int }}px{% endif %} }
  .panel .pnl{position:absolute;background:var(--paper);display:flex;flex-direction:column;justify-content:center;padding:0 64px;text-align:right;
    {% if panel_side == 'bottom' %}left:0;right:0;bottom:0;height:{{ (h*0.32)|int }}px{% else %}top:0;bottom:0;width:{{ (w*0.4)|int }}px;{{ panel_side }}:0{% endif %}}
  .panel .hl{font-family:'OptB';font-size:72px;line-height:1.05}
  .panel .l2{font-family:'OptL'}
  .panel .sub{font-family:'OptR';font-size:38px;letter-spacing:1px;margin-top:22px}
  .panel .sig{font-family:'Script';font-size:104px;margin-top:10px;line-height:1}
  .panel .brand{ {% if panel_side=='bottom' %}top:40px;bottom:auto{% else %}top:auto;bottom:48px;{{ 'left' if panel_side=='right' else 'right' }}:auto;{{ panel_side }}:0;width:{{ (w*0.4)|int }}px;color:var(--ink){% endif %} }

  /* 7 label — museum label: small Regular headline, hairline, detail list */
  .label .zone{text-align:right}
  .label .card{display:inline-block;align-self:flex-{{ 'start' }};max-width:600px}
  .label .hl{font-family:'OptB';font-size:74px;line-height:1.12}
  .label .rule{width:100%;height:1px;background:var(--ink);opacity:.5;margin:20px 0}
  .label .sub{font-family:'OptR';font-size:38px;line-height:1.5}
</style></head>
<body><div class="ad {{ direction }}">
  <img class="photo" src="{{ img }}">
  {% set lines = headline.split('<br>') %}
  {% if direction == 'panel' %}
    <div class="pnl">
      <div class="hl fitw">{{ lines[0] }}{% if lines|length > 1 %}<br><span class="l2">{{ lines[1:]|join(' ') }}</span>{% endif %}</div>
      {% if sub %}<div class="sub">{{ sub }}</div>{% endif %}
      {% if signature %}<div class="sig">{{ signature }}</div>{% endif %}
    </div>
  {% else %}
    {% if scrim_on %}<div class="scrim"></div>{% endif %}
    {% if direction == 'cover' %}<div class="frame"></div><div class="mast">{{ brand }}</div>{% endif %}
    <div class="zone">
    {% if direction == 'contrast' %}
      <div class="l1 fit">{{ lines[0] }}</div>{% if lines|length > 1 %}<div class="l2 fit">{{ lines[1:]|join(' ') }}</div>{% endif %}
      {% if sub %}<div class="sub">{{ sub }}</div>{% endif %}
    {% elif direction == 'quiet' %}
      <div class="hl">{{ headline|safe }}</div>
      {% if signature %}<div class="sig">{{ signature }}</div>{% endif %}
      {% if sub %}<div class="sub">{{ sub }}</div>{% endif %}
    {% elif direction == 'stack' %}
      {% for ln in lines %}<div class="l fit {{ 'light' if loop.index == 2 else '' }}">{{ ln }}</div>{% endfor %}
      {% if sub %}<div class="sub">{{ sub }}</div>{% endif %}
    {% elif direction == 'note' %}
      <div class="hand">{{ (note or headline)|safe }}</div>
      <div class="rule"></div>
      {% if note %}<div class="hl">{{ headline.replace('<br>', ' ') }}</div>{% endif %}
      {% if sub %}<div class="sub">{{ sub }}</div>{% endif %}
    {% elif direction == 'cover' %}
      <div class="hl">{{ headline|safe }}</div>
      {% if sub %}<div class="sub">{{ sub }}</div>{% endif %}
    {% elif direction == 'label' %}
      <div class="card"><div class="hl">{{ headline|safe }}</div><div class="rule"></div>
      {% if sub %}<div class="sub">{{ sub.replace(' · ', '<br>')|safe }}</div>{% endif %}</div>
    {% endif %}
    </div>
  {% endif %}
  {% if brand and brand_color and direction != 'cover' %}<div class="brand">{{ brand }}</div>{% endif %}
</div>
<script>
  // shrink single-line headline pieces until they fit their box width
  document.fonts.ready.then(() => {
    for (const el of document.querySelectorAll('.fit, .fitw')) {
      const box = el.closest('.zone, .pnl');
      if (!box) continue;
      const max = box.clientWidth;
      let size = parseFloat(getComputedStyle(el).fontSize);
      el.style.display = 'inline-block';
      while (el.scrollWidth > max && size > 18) { size -= 2; el.style.fontSize = size + 'px'; }
      el.style.display = '';
    }
    // then make the block fit its zone height: drop signature, then sub line, before shrinking the headline
    for (const z of document.querySelectorAll('.zone, .pnl')) {
      for (const sel of ['.sig', '.sub']) {
        if (z.scrollHeight <= z.clientHeight + 2) break;
        z.querySelectorAll(sel).forEach(el => el.style.display = 'none');
      }
      let guard = 0;
      while (z.scrollHeight > z.clientHeight + 2 && guard++ < 30) {
        for (const el of z.querySelectorAll('*')) {
          const fs = parseFloat(getComputedStyle(el).fontSize);
          if (fs > 22) el.style.fontSize = (fs * 0.94) + 'px';
        }
      }
    }
    document.body.dataset.ready = '1';
  });
</script>
</body></html>
