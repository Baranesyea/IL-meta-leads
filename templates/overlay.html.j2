<!doctype html>
<html lang="he" dir="rtl"><head><meta charset="utf-8">
{% for f in fonts %}{% if f.google %}<link href="https://fonts.googleapis.com/css2?family={{ f.family|replace(' ', '+') }}:wght@{{ f.weight }}&display=swap" rel="stylesheet">{% endif %}{% endfor %}
<style>
  {% for f in fonts %}{% if f.file %}@font-face{font-family:'{{ f.family }}';src:url('{{ f.file_uri }}');font-weight:{{ f.weight }};}{% endif %}{% endfor %}
  html,body{margin:0;padding:0}
  .ad{position:relative;width:{{w}}px;height:{{h}}px;overflow:hidden;background:#000}
  .ad img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .shade{position:absolute;inset:0;background:linear-gradient({{ 'to bottom' if pos=='top' else 'to top' }}, {{shade}} 0%, transparent 42%)}
  .copy{position:absolute;left:0;right:0;{{pos}}:{{ top_px }}px;text-align:center;color:{{color}};padding:0 90px}
  .h{font-family:'{{ hf.family }}',serif;font-weight:{{ hf.weight }};font-size:{{size}}px;line-height:1.12;letter-spacing:.5px}
  .sub{font-family:'{{ sf.family }}',sans-serif;font-weight:{{ sf.weight }};font-size:26px;letter-spacing:3px;margin-top:22px;opacity:.85}
  .brand{position:absolute;left:0;right:0;{{ 'bottom' if pos=='top' else 'top' }}:64px;text-align:center;color:{{color}};
         font-family:'{{ bf.family }}',serif;font-weight:{{ bf.weight }};font-size:26px;letter-spacing:1px;opacity:.9;text-shadow:0 0 12px rgba(0,0,0,.15)}
</style></head>
<body><div class="ad">
  <img src="{{img}}">
  <div class="shade"></div>
  <div class="copy"><div class="h">{{headline|safe}}</div>{% if sub %}<div class="sub">{{sub}}</div>{% endif %}</div>
  <div class="brand">{{brand}}</div>
</div></body></html>
